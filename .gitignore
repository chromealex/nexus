# Generated dependencies and builds
**/node_modules/
**/target/
**/dist/
**/.DS_Store
*.dmg
*.app/
*.log
# Local configuration and credentials
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/credentials.json
**/auth.json
# Downloaded tooling; source assets stay versioned
/add-on-mpfb-*.zip
# Generated Tauri schemas and local agent backups
**/src-tauri/gen/schemas/
**/.nexus-backup-*/
# Local backups and parked assets (agents put file backups here)
/.backups/
# Compatibility link to app/ for tools that still use the old path
/v0.20.2

# Signing material never goes into git
.signing/
*.p12
*.p8
*.cer
*.mobileprovision

# Large source assets stay local
*.glb
generated_images/
*.tmp.rs
